# Site metadata (set when custom domain is live)
NEXT_PUBLIC_SITE_URL=https://gofoundry-seven.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional open-source IdP
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=
# Waitlist (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Platform database (PostgreSQL) — use Supabase transaction pooler on Vercel (:6543)
DATABASE_URL=
# Optional: remote sandbox worker (default: local go executor)
SANDBOX_WORKER_URL=http://localhost:8081
GO_BIN=go
# Redis task queue (optional — falls back to in-memory)
REDIS_URL=redis://localhost:6379
# Upstash Redis REST (recommended on Vercel free tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_TEAM_YEARLY_PRICE_ID=
